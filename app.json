{
  "expo": {
    "name": "Altera Interior",
    "slug": "employee-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alterainteriors",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "package": "com.alterainterior.alterainteriors"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Altera Interior to access your camera to capture live attendance selfies."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Altera Interior to access your photos to update your profile picture.",
          "cameraPermission": "Allow Altera Interior to use your camera to take a profile photo."
        }
      ],
      "expo-image",
      "expo-sharing",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://alterabackend.onrender.com/api",
      "apiUrlLan": "https://alterabackend.onrender.com/api",
      "googleWebClientId": "205668201564-tllj3s854jgk8qrn515hr2reo88qpj6g.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "215e164e-be00-442a-83ea-5067a9a61193"
      }
    },
    "owner": "altera12345"
  }
}
