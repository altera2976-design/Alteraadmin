# ==============================================================================
# Attendance & Payroll App - Client Environment Configuration
# ==============================================================================

# Backend API URL:
# For local development: http://192.168.x.x:5001/api (use your local LAN IP)
# For production client APK: https://your-production-api-domain.com/api
EXPO_PUBLIC_API_URL=https://your-production-api-domain.com/api

# Google OAuth Web Client ID (from Google Cloud / Firebase Console)
# Required to obtain Google idToken for native Google Sign-In:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
